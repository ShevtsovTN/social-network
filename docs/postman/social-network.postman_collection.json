      "name": "Register",
      "item": [
        {
          "name": "Register - success",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('returns generated uuid', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('id');",
                  "    pm.expect(body.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);",
                  "    pm.collectionVariables.set('userId', body.id);",
                  "});",
                  "",
                  "pm.collectionVariables.set('password', 's3cret-password');",
                  "pm.collectionVariables.set('firstName', 'Ivan');",
                  "pm.collectionVariables.set('lastName', 'Petrov');",
                  "pm.collectionVariables.set('birthDate', '1990-05-17');",
                  "pm.collectionVariables.set('gender', 'male');",
                  "pm.collectionVariables.set('city', 'Moscow');",
                  "pm.collectionVariables.set('interests', JSON.stringify(['hiking', 'chess']));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Ivan\",\n  \"lastName\": \"Petrov\",\n  \"birthDate\": \"1990-05-17\",\n  \"gender\": \"male\",\n  \"interests\": [\"hiking\", \"chess\"],\n  \"city\": \"Moscow\",\n  \"password\": \"s3cret-password\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/user/register",
              "host": ["{{baseUrl}}"],
              "path": ["user", "register"]
            }
          },
          "response": []
        },
