    {
      "name": "Get user",
      "item": [
        {
          "name": "Get user - success",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('profile matches what was registered', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.id).to.eql(pm.collectionVariables.get('userId'));",
                  "    pm.expect(body.firstName).to.eql(pm.collectionVariables.get('firstName'));",
                  "    pm.expect(body.lastName).to.eql(pm.collectionVariables.get('lastName'));",
                  "    pm.expect(body.birthDate).to.eql(pm.collectionVariables.get('birthDate'));",
                  "    pm.expect(body.gender).to.eql(pm.collectionVariables.get('gender'));",
                  "    pm.expect(body.interests).to.eql(JSON.parse(pm.collectionVariables.get('interests')));",
                  "    pm.expect(body.city).to.eql(pm.collectionVariables.get('city'));",
                  "});",
                  "",
                  "pm.test('password is never exposed', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.not.have.property('password');",
                  "    pm.expect(body).to.not.have.property('passwordHash');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/user/get/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["user", "get", "{{userId}}"]
            }
          },
          "response": []
        },
