  "templating": {
    "list": [
      {
        "name": "experiment",
        "label": "Эксперимент",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(k6_acked_registrations_total, experiment)",
          "refId": "v"
        },
        "refresh": 2,
        "sort": 2,
        "includeAll": false,
        "multi": false,
        "current": {},
        "regex": "/^(failover-(?:async|sync))-(?:native|symfony)$/"
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "События эксперимента",
