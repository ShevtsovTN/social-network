        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Подтверждено записей, нарастающим итогом",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Итог должен совпасть со строкой «Подтверждено клиенту» в summary.md.",
