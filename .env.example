POSTGRES_DB=social
POSTGRES_USER=social
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
# Лимиты ресурсов каждого узла PostgreSQL (одинаковые для primary и standby).
POSTGRES_CPUS=0.5
POSTGRES_MEMORY=1G

NATIVE_PORT=8081
SYMFONY_PORT=8082
FRONTEND_PORT=8080

AUTH_TOKEN_SECRET=change_me
SYMFONY_APP_SECRET=change_me

# Target PHP-образа: dev (по умолчанию) или bench. Обычно задаётся через `make bench-up`.
# PHP_BUILD_TARGET=dev
