POSTGRES_DB=social
POSTGRES_USER=social
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
# Лимиты ресурсов каждого узла PostgreSQL (одинаковые для primary и standby).
POSTGRES_CPUS=0.5
POSTGRES_MEMORY=1G
# Порты реплик на хосте (для psql и IDE).
POSTGRES_REPLICA_1_PORT=5433
POSTGRES_REPLICA_2_PORT=5434
# Роль потоковой репликации: создаётся на primary при инициализации тома.
REPLICATION_USER=replicator
REPLICATION_PASSWORD=change_me

# Кластер Citus для диалогов: база, пользователь и пароль те же, что выше. Порт координатора на хосте и лимиты
# ресурсов: у координатора свои, у всех воркеров одинаковые.
DIALOGS_POSTGRES_PORT=5440
DIALOGS_COORDINATOR_CPUS=1
DIALOGS_COORDINATOR_MEMORY=512M
DIALOGS_WORKER_CPUS=0.5
DIALOGS_WORKER_MEMORY=512M

# Redis (кэш ленты и очередь событий). MAXMEMORY держать около 75% от лимита контейнера MEMORY.
REDIS_PASSWORD=change_me
REDIS_PORT=6379
REDIS_CPUS=1
REDIS_MEMORY=512M
REDIS_MAXMEMORY=384mb

NATIVE_PORT=8081
SYMFONY_PORT=8082
FRONTEND_PORT=8080
HAPROXY_STATS_PORT=8404
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

AUTH_TOKEN_SECRET=change_me
SYMFONY_APP_SECRET=change_me

# Target PHP-образа: dev (по умолчанию) или bench. Обычно задаётся через `make bench-up`.
# PHP_BUILD_TARGET=dev

# Мониторинг (профиль monitoring): роль только для чтения статистики и вход в Grafana.
MONITORING_USER=exporter
MONITORING_PASSWORD=change_me
GRAFANA_ADMIN_PASSWORD=change_me
